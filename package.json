{
  "name": "linkdesk-plugin-serial-monitor",
  "version": "1.0.11",
  "private": true,
  "type": "module",
  "description": "串口监视器（出厂预装，可卸载）——独立仓可自足构建：build 走 @linkdesk/plugin-sdk 的 npm 通道。不列 serialport（方案①留壳，走 window.linkdesk.serial.* 数据源后门通道）；@codemirror×3 + @linkdesk/ui 自声明（E6#16 谁消费谁声明）",
  "scripts": {
    "dev": "linkdesk-plugin-sdk dev",
    "dev:real": "linkdesk-plugin-sdk dev --real",
    "build": "linkdesk-plugin-sdk build",
    "validate": "linkdesk-plugin-sdk validate",
    "lint": "linkdesk-plugin-sdk lint",
    "publish": "linkdesk-plugin-sdk publish",
    "verify": "node scripts/ci-verify.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@linkdesk/ui": "^0.2.0"
  },
  "devDependencies": {
    "@linkdesk/plugin-sdk": "^0.1.19",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.12",
    "jsdom": "^29.1.1",
    "jsonc-parser": "^3.3.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
