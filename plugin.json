{
  "$schema": "./node_modules/@linkdesk/plugin-sdk/schemas/plugin.schema.json",
  "pluginId": "serial-monitor",
  "name": "串口监视器",
  "version": "1.0.25",
  "minAppVersion": "0.2.20",
  "icon": "resources/icon-bar.svg",
  "marketIcon": "resources/icon.svg",
  "description": "串口数据监视器——接收区（CM6）+ 发送栏（Monaco）+ 侧栏设置。LinkDesk 第一个视图插件，通用容器基础设施在此验证。不绑定任何特定用途。",
  "author": "官方",
  "entry": "src/index.tsx",
  "appearsIn": { "iconBar": "top", "sidePanel": true, "tabBar": true, "statusBar": "src/components/statusBar.tsx" },
  "tabBehavior": {
    "invokeBeforeClose": "close_port",
    "identityField": "sourceId"
  },
  "statusBar": [
    { "id": "connection", "icon": "circle-filled", "label": "", "align": "left" }
  ],
  "contributes": {
    "i18n": { "en": "i18n/en.json" },
    "viewsContainers": {
      "serial-monitor": {
        "title": "串口监视器",
        "location": "sidebar",
        "hideIfEmpty": false
      }
    },
    "views": {
      "serial-monitor": [
        {
          "id": "sessions",
          "title": "串口监视器会话",
          "render": "src/views/SessionListView.tsx",
          "order": 0,
          "minHeight": 120
        },
        {
          "id": "receive-and-send",
          "title": "收发设置",
          "render": "src/views/SerialSettingsView.tsx",
          "order": 1,
          "minHeight": 500
        }
      ]
    },
    "configuration": {
      "title": "串口监视器",
      "properties": {
        "serial-monitor.statusBar.connection": {
          "type": "boolean",
          "default": true,
          "description": "状态栏显示连接状态指示灯"
        },
        "serial-monitor.confirmOnClose": {
          "type": "boolean",
          "default": true,
          "description": "关闭时提示"
        }
      }
    },
    "configurationDefaults": {
      "serial-monitor.statusBar.connection": true,
      "serial-monitor.confirmOnClose": true
    },
    "commands": [
      { "id": "serial-monitor.copy", "title": "复制", "category": "串口监视器", "when": "activeEditor == 'serial-monitor'",
        "description": "复制接收区中选中的文本到剪贴板。" },
      { "id": "serial-monitor.selectAll", "title": "全选", "category": "串口监视器", "when": "activeEditor == 'serial-monitor'",
        "description": "选中接收区的全部内容。" },
      { "id": "serial-monitor.clear", "title": "清空接收区", "category": "串口监视器", "when": "activeEditor == 'serial-monitor'",
        "description": "清空接收区显示内容（连同语法着色装饰一并清）。" },
      { "id": "serial-monitor.clearSend", "title": "清空发送区", "category": "串口监视器", "when": "activeEditor == 'serial-monitor'",
        "description": "清空发送输入框里的内容。" },
      { "id": "serial-monitor.togglePause", "title": "暂停接收", "category": "串口监视器", "when": "activeEditor == 'serial-monitor' && serial-monitor.sourceOpen",
        "description": "暂停/继续接收区刷新（暂停期间数据进缓冲，继续后补显示）。" },
      { "id": "serial-monitor.exportLog", "title": "导出日志", "category": "串口监视器", "when": "activeEditor == 'serial-monitor'",
        "description": "把接收区当前内容导出为 .txt 日志文件（弹保存对话框）。" },
      { "id": "serial-monitor.toggleSendMode", "title": "切换到 HEX 发送", "category": "串口监视器", "when": "activeEditor == 'serial-monitor'",
        "description": "在文本发送与 HEX 发送之间切换。" },
      { "id": "serial-monitor.toggleEcho", "title": "关闭消息回显", "category": "串口监视器", "when": "activeEditor == 'serial-monitor'",
        "description": "打开/关闭发送内容在接收区的回显。" },
      { "id": "serial-monitor.toggleLineNumbers", "title": "隐藏行号", "category": "串口监视器", "when": "activeEditor == 'serial-monitor'",
        "description": "显示/隐藏接收区行号。" },
      { "id": "serial-monitor.quickSendFill", "title": "回填到发送区", "category": "串口监视器", "when": "activeEditor == 'serial-monitor'",
        "description": "把某颗快捷发送的内容回填进发送输入框（不发送）。",
        "params": [{ "name": "args", "type": "object", "description": "{ quickSendName }——要回填的那颗" }] },
      { "id": "serial-monitor.quickSendEdit", "title": "编辑", "category": "串口监视器", "when": "activeEditor == 'serial-monitor'",
        "description": "进入某颗快捷发送的编辑态（等于在药丸上右键 → 编辑）。编辑框是视图态，需该会话的串口标签页在场。",
        "params": [{ "name": "args", "type": "object", "description": "{ quickSendName, sessionId? }" }] },
      { "id": "serial-monitor.quickSendDelete", "title": "删除", "category": "串口监视器", "when": "activeEditor == 'serial-monitor'",
        "description": "删除某颗快捷发送（等于在药丸上右键 → 删除）。无需视图在场（会话数据是模块级）。",
        "params": [{ "name": "args", "type": "object", "description": "{ quickSendName, sessionId? }" }] },
      { "id": "serial-monitor.openPort", "title": "打开端口", "category": "串口监视器", "when": "activeEditor == 'serial-monitor'",
        "description": "打开串口端口——可指定 COM 口 / 波特率 / 帧格式（数据位·停止位·校验）；与界面点「打开」走同一条链路（侧栏灯、会话表一起动）。已在开则不动。无需视图在场。",
        "params": [{ "name": "args", "type": "object", "description": "{ portName?, baudRate?, dataBits?, stopBits?, parity?, encoding?, sessionId? }" }] },
      { "id": "serial-monitor.closePort", "title": "关闭端口", "category": "串口监视器", "when": "activeEditor == 'serial-monitor'",
        "description": "关闭已打开的串口端口（按口显式熄灯，走与界面同一写入链路）。未开则如实回 alreadyClosed，不假装关过。",
        "params": [{ "name": "args", "type": "object", "description": "{ portName?, sessionId? }——缺省取活跃会话的口" }] },
      { "id": "serial-monitor.closeSession", "title": "关闭串口会话", "category": "串口监视器", "when": "activeEditor == 'serial-monitor'",
        "description": "关闭一个串口会话（等于侧栏会话条目上的 ✕）：开着串口会先断开、再关标签页、再删会话。「关闭时提示」配置开着且未传 confirm 时先弹确认框（用户不点头 = 不做，如实回 denied）。",
        "params": [{ "name": "args", "type": "object", "description": "{ sessionId?, name?, confirm? }——缺省关活跃会话" }] },
      { "id": "serial-monitor.setSendCoding", "title": "设置发送编码", "category": "串口监视器", "when": "activeEditor == 'serial-monitor'",
        "description": "设置本会话的发送编码（等于侧栏「发送编码」下拉）——可选 UTF-8 / GB2312 / Shift-JIS / Latin-1。发送单条消息时的临时编码走 serial-monitor.send 的 encoding 实参，不改本设置。",
        "params": [{ "name": "args", "type": "object", "description": "{ coding: UTF-8|GB2312|Shift-JIS|Latin-1, sessionId? }" }] },
      { "id": "serial-monitor.send", "title": "发送", "category": "串口监视器", "when": "false",
        "description": "往串口发数据（文本或 HEX）——文本可指定编码（缺省用目标会话的发送编码）。不传 portName 时按「缺省唯一口」语义发送。when=false：纯程序化命令，不进命令面板。",
        "params": [
          { "name": "sendMode", "type": "string", "required": true, "description": "text | hex" },
          { "name": "data", "type": "string", "required": true, "description": "文本正文，或空格/逗号分隔的十六进制字节" },
          { "name": "portName", "type": "string", "description": "目标端口——缺省按唯一已打开口" },
          { "name": "encoding", "type": "string", "description": "文本编码——缺省用会话的发送编码" }
        ] }
    ],
    "menus": {
      "editorContext": [
        { "command": "serial-monitor.copy", "group": "edit", "when": "activeEditor == 'serial-monitor'" },
        { "command": "serial-monitor.selectAll", "group": "edit", "when": "activeEditor == 'serial-monitor'" },
        { "command": "serial-monitor.clear", "group": "serial-monitor", "when": "activeEditor == 'serial-monitor'" },
        { "command": "serial-monitor.togglePause", "group": "serial-monitor", "when": "activeEditor == 'serial-monitor' && serial-monitor.sourceOpen" }
      ],
      "quickSendContext": [
        { "command": "serial-monitor.quickSendFill", "group": "edit" },
        { "command": "serial-monitor.quickSendEdit", "group": "edit" },
        { "command": "serial-monitor.quickSendDelete", "group": "delete" }
      ],
      "commandPalette": [
        { "command": "serial-monitor.clear", "when": "activeEditor == 'serial-monitor'" },
        { "command": "serial-monitor.clearSend", "when": "activeEditor == 'serial-monitor'" },
        { "command": "serial-monitor.togglePause", "when": "activeEditor == 'serial-monitor' && serial-monitor.sourceOpen" },
        { "command": "serial-monitor.exportLog", "when": "activeEditor == 'serial-monitor'" },
        { "command": "serial-monitor.toggleSendMode", "when": "activeEditor == 'serial-monitor'" },
        { "command": "serial-monitor.toggleEcho", "when": "activeEditor == 'serial-monitor'" },
        { "command": "serial-monitor.toggleLineNumbers", "when": "activeEditor == 'serial-monitor'" },
        { "command": "serial-monitor.openPort", "when": "activeEditor == 'serial-monitor'" },
        { "command": "serial-monitor.closePort", "when": "activeEditor == 'serial-monitor'" },
        { "command": "serial-monitor.closeSession", "when": "activeEditor == 'serial-monitor'" }
      ]
    }
  },
  "recommends": [
    { "plugin": "workspace", "reason": "配合卡片可视化串口数据" }
  ],
  "suggests": [
    { "plugin": "protocol-bracket", "reason": "协议解析——不装则只能查看原始数据" }
  ]
}
